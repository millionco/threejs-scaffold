{
  "name": "threejs-scaffolding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "bun test ./tests/*.test.ts",
    "test:e2e": "bun run build && THREE_TESTER_HTML=\"$PWD/dist/index.html\" playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check": "bun run typecheck && bun run test && bun run test:e2e",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "@types/node": "22.13.10",
    "@types/three": "0.185.1",
    "three-tester": "file:./three-tester-0.1.0.tgz",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
