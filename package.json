{
  "name": "threejs-scaffolding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check": "bun run typecheck && bun test && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/three": "0.185.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
